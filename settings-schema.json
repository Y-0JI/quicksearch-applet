{
    "qs-header": {
        "type": "section",
        "description": "QUICK SEARCH"
    },
    "sec-general": {
        "type": "section",
        "description": "General"
    },
    "open-shortcut": {
        "type": "keybinding",
        "description": "Keyboard shortcut",
        "default": "<Super>f"
    },
    "enable-files": {
        "type": "switch",
        "description": "Enable file search",
        "default": true
    },
    "enable-web": {
        "type": "switch",
        "description": "Enable web search",
        "default": true
    },
    "show-recent": {
        "type": "switch",
        "description": "Show recent searches while typing",
        "default": true
    },
    "sec-search": {
        "type": "section",
        "description": "Search"
    },
    "search-engine": {
        "type": "combobox",
        "description": "Web search engine",
        "default": "ddgo",
        "options": {
            "DuckDuckGo": "ddgo",
            "Google (Serper API)": "google",
            "Bing": "bing",
            "SearXNG (Local)": "searxng"
        }
    },
    "searxng-url": {
        "type": "entry",
        "description": "Local SearXNG instance URL (e.g. http://127.0.0.1:8080)",
        "default": "http://127.0.0.1:8080"
    },
    "web-search-api-key": {
        "type": "entry",
        "description": "Web search API key (required for Google/Serper. Get free key at serper.dev)",
        "default": ""
    },
    "max-apps": {
        "type": "spinbutton",
        "description": "Max application results",
        "default": 5,
        "min": 1,
        "max": 20,
        "step": 1,
        "units": "apps"
    },
    "max-files": {
        "type": "spinbutton",
        "description": "Max file results",
        "default": 15,
        "min": 1,
        "max": 50,
        "step": 1,
        "units": "files"
    },
    "max-web": {
        "type": "spinbutton",
        "description": "Max web results",
        "default": 5,
        "min": 1,
        "max": 20,
        "step": 1,
        "units": "results"
    },
    "debounce-ms": {
        "type": "spinbutton",
        "description": "Search delay",
        "default": 150,
        "min": 50,
        "max": 1000,
        "step": 10,
        "units": "ms"
    },
    "sec-ai": {
        "type": "section",
        "description": "AI"
    },
    "ai-provider": {
        "type": "combobox",
        "description": "AI provider",
        "default": "9router",
        "options": {
            "9Router (local)": "9router",
            "OpenRouter": "openrouter",
            "OpenAI": "openai",
            "Custom OpenAI-compatible": "custom"
        }
    },
    "ai-model": {
        "type": "entry",
        "description": "AI model / Combo",
        "default": ""
    },
    "ai-api-key": {
        "type": "entry",
        "description": "AI API key",
        "default": ""
    },
    "ai-max-tokens": {
        "type": "spinbutton",
        "description": "Max AI tokens",
        "default": 2048,
        "min": 256,
        "max": 16384,
        "step": 128,
        "units": "tokens"
    },
    "ai-vision-supported": {
        "type": "switch",
        "description": "Model supports images (enables screen analysis)",
        "default": false
    },
    "ai-agent-enabled": {
        "type": "switch",
        "description": "Enable AI Agent (tools: apps, files, web, screen, control)",
        "default": true
    },
    "ai-computer-control": {
        "type": "switch",
        "description": "Allow computer control (click, type, keys, scroll, focus)",
        "default": false
    },
    "sec-advanced": {
        "type": "section",
        "description": "Advanced"
    },
    "ai-endpoint": {
        "type": "entry",
        "description": "Leave empty to use the selected provider default.",
        "default": ""
    },
    "file-locations": {
        "type": "list",
        "description": "File search locations",
        "default": [],
        "columns": [
            {
                "id": "path",
                "title": "Path",
                "type": "string",
                "expander": true
            }
        ]
    },
    "recent-queries": {
        "type": "generic",
        "description": "Internal: recent search history (managed automatically)",
        "default": ""
    }
}
