{
    "qs-header": {
        "type": "section",
        "description": "QUICK SEARCH"
    },
    "sec-general": {
        "type": "section",
        "description": "General"
    },
    "open-shortcut": {
        "type": "keybinding",
        "description": "Keyboard shortcut",
        "default": "<Super>f"
    },
    "enable-files": {
        "type": "switch",
        "description": "Enable file search",
        "default": true
    },
    "enable-web": {
        "type": "switch",
        "description": "Enable web search",
        "default": true
    },
    "show-recent": {
        "type": "switch",
        "description": "Show recent searches while typing",
        "default": true
    },
    "sec-search": {
        "type": "section",
        "description": "Search"
    },
    "search-engine": {
        "type": "combobox",
        "description": "Web search engine",
        "default": "ddgo",
        "options": {
            "DuckDuckGo": "ddgo",
            "Google (Serper API)": "google",
            "Bing": "bing",
            "SearXNG (Local)": "searxng"
        }
    },
    "searxng-url": {
        "type": "entry",
        "description": "Local SearXNG instance URL (e.g. http://127.0.0.1:8080)",
        "default": "http://127.0.0.1:8080"
    },
    "web-search-api-key": {
        "type": "entry",
        "description": "Web search API key (required for Google/Serper. Get free key at serper.dev)",
        "default": ""
    },
    "max-apps": {
        "type": "spinbutton",
        "description": "Max application results",
        "default": 5,
        "min": 1,
        "max": 20,
        "step": 1,
        "units": "apps"
    },
    "max-files": {
        "type": "spinbutton",
        "description": "Max file results",
        "default": 15,
        "min": 1,
        "max": 50,
        "step": 1,
        "units": "files"
    },
    "max-web": {
        "type": "spinbutton",
        "description": "Max web results",
        "default": 5,
        "min": 1,
        "max": 20,
        "step": 1,
        "units": "results"
    },
    "debounce-ms": {
        "type": "spinbutton",
        "description": "Search delay",
        "default": 150,
        "min": 50,
        "max": 1000,
        "step": 10,
        "units": "ms"
    },
    "sec-ai": {
        "type": "section",
        "description": "AI Search"
    },
    "ai-base-url": {
        "type": "entry",
        "description": "AI base URL (9router, e.g. http://127.0.0.1:20128)",
        "default": ""
    },
    "ai-api-key": {
        "type": "entry",
        "description": "AI API key (9router)",
        "default": ""
    },
    "ai-model": {
        "type": "entry",
        "description": "AI model (e.g. gpt-4o-mini, coba9router)",
        "default": ""
    },
    "ai-max-output-tokens": {
        "type": "spinbutton",
        "description": "Maximum AI response length",
        "default": 4096,
        "min": 512,
        "max": 16384,
        "step": 256,
        "units": "tokens"
    },
    "ai-debug-mode": {
        "type": "switch",
        "description": "AI Debug Mode (show diagnostic Stage/Error/Status)",
        "default": false
    },
    "sec-advanced": {
        "type": "section",
        "description": "Advanced"
    },
    "file-locations": {
        "type": "list",
        "description": "File search locations",
        "default": [],
        "columns": [
            {
                "id": "path",
                "title": "Path",
                "type": "string",
                "expander": true
            }
        ]
    },
    "recent-queries": {
        "type": "generic",
        "description": "Internal: recent search history (managed automatically)",
        "default": ""
    }
}
